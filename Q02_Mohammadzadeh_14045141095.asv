clear
clc
%Exercise 2 _Solar Panel Income
%part A
x = 4.2;       %Average daily production in kwh
y = 5000;      %Price per kwh in Toman
a = 30;        %days in a month
b = 365;       %days in a year
%part B
M = a * x * y;
Y = b * x * y;
%part C
fprintf('Monthly Income : %.2f Toman\n',M);
fprintf('Yearly Income : %.2f Toman\n',Y);
% to print a % you have to use %% in fprintf
%part D
who;
format short;
fprintf('\n\nformat short(10/3) :\n\n');
10 / 3
format long;
fprintf('format long(10/3');
10 / 3